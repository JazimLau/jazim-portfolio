# ─────────────────────────────────────────────────────────────
# GitHub Pages 备用 / Mirror 构建（npm run build:github 使用 --mode github 加载）
#   VITE_DEPLOY_TARGET = github   标识部署目标
#   VITE_BASE                     仓库子路径；若 Repo 是 USERNAME.github.io 用户站，改为 /
#   VITE_MEDIA_BASE_URL           生产媒体域名（公开 URL，非 Secret）
# ─────────────────────────────────────────────────────────────
VITE_DEPLOY_TARGET=github
VITE_BASE=/jazim-portfolio/
VITE_MEDIA_BASE_URL=https://media.jazimprofile.com
