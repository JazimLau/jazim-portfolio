# ─────────────────────────────────────────────────────────────
# Tencent EdgeOne 正式主站构建（npm run build:deploy 使用 --mode tencent 加载）
#   VITE_DEPLOY_TARGET = tencent  标识部署目标（vite.config.ts 读取语义）
#   VITE_BASE = /                 EdgeOne 域名根目录
#   VITE_MEDIA_BASE_URL           生产媒体域名（公开 URL，非 Secret）
# ─────────────────────────────────────────────────────────────
VITE_DEPLOY_TARGET=tencent
VITE_BASE=/
VITE_MEDIA_BASE_URL=https://jazimprofile-media-1465643833.cos.ap-guangzhou.myqcloud.com
