{
  "rewrites": [
    {
      "source": "/media-proxy/:path*",
      "destination": "https://jazimprofile-media-1465643833.cos.ap-guangzhou.myqcloud.com/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist"
}
