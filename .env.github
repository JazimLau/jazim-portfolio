# ─────────────────────────────────────────────────────────────
# GitHub Pages 主站构建（npm run build:github 使用 --mode github 加载）
#   VITE_DEPLOY_TARGET = github   标识部署目标
#   VITE_BASE = ./                相对 base：同一构建同时兼容
#                                 · jazimlau.github.io/jazim-portfolio/（仓库子路径）
#                                 · 自定义域名 jazimportfolio.com/（根路径，免备案）
#                                 注：因当前无 ICP 备案，主站走 GitHub Pages 自定义域名
#   VITE_MEDIA_BASE_URL           生产媒体域名（公开 URL，非 Secret）
# ─────────────────────────────────────────────────────────────
VITE_DEPLOY_TARGET=github
VITE_BASE=./
VITE_MEDIA_BASE_URL=https://jazimprofile-media-1465643833.cos.ap-guangzhou.myqcloud.com
